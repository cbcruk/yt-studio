{
  // There is no .js in the repo. Source, tests, and generators are all .ts, and bun
  // runs them as is. So the two things eslint used to check (no-undef,
  // no-unused-vars) are checked here — tsc catches undeclared names and
  // noUnusedLocals catches dead locals. Parameters aren't checked (matching
  // args:'none' in the old eslint config).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    "strict": true,
    // An index can miss. `schema.byId[id]!` once asserted an option the schema didn't have (#23).
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",

    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/index.ts", "src/cli.ts"]
}
