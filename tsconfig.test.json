{
  // Type-check only. The @ts-expect-error in tests/types/reject.ts bites both ways,
  // so passing this means "blocks what must be blocked, passes what must pass".
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,

    // bun types go in **here only**. Tests import `bun:test`, so they're needed,
    // but putting them in tsconfig.json (the build) would make Bun.* visible in the
    // shipped src/ too — and then code using `Bun.file()` blows up on users' Node.
    //
    // So this file is loose about src/, and tsconfig.json is what tightens it.
    // `bun run build` rechecks with types: ["node"], so it's caught eventually —
    // just be aware it's caught one step later.
    "types": ["node", "bun"]
  },
  "include": ["src/index.ts", "src/cli.ts", "gen_options.ts", "tests/**/*.ts"]
}
