{
  "name": "ytstudio",
  "version": "0.1.0",
  "description": "설치된 yt-dlp 를 리플렉션해서 만든 타입 빌더와 명령어 검증기",
  "license": "MIT",
  "author": "cbcruk",
  "type": "module",
  "scripts": {
    "gen:types": "bun gen_options.ts",
    "build": "tsc",
    "check:types": "tsc -p tsconfig.test.json",
    "test:unit": "bun test tests/unit",
    "test:cli": "bun test tests/cli.test.ts",
    "test": "bun run check:types && bun run build && bun run test:unit && bun run test:cli && bun run test:types",
    "cli": "bun src/cli.ts",
    "prepare": "npm run build",
    "test:types": "bun test tests/types.test.ts",
    "test:drift": "bun test tests/drift.test.ts",
    "prepublishOnly": "bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "ytstudio.schema.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/yt-studio.git"
  },
  "homepage": "https://github.com/cbcruk/yt-studio#readme",
  "bugs": "https://github.com/cbcruk/yt-studio/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ytstudio": "./lib/cli.js"
  },
  "keywords": [
    "yt-dlp",
    "builder",
    "typescript",
    "lint",
    "cli"
  ],
  "packageManager": "bun@1.3.14"
}
